{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "    {#green}{user-name}{#}@{#green}{host-name}{#}"
        },
        {
            "type": "os",
            "key": "    os     ",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "    kernel ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "    shell  ",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "format": "{?days}{days}d {?}{hours}h {minutes}m",
            "key": "    uptime ",
            "keyColor": "cyan"
        },
        {
            "type": "battery",
            "format": "{capacity} {status}",
            "key": "    battery",
            "keyColor": "magenta"
        },
        {
            "type": "WM",
            "key": "    wm     ",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "    pkgs   ",
            "keyColor": "light_red"
        },
        {
            "type": "memory",
            "key": "    memory ",
            "keyColor": "light_yellow"
        },
        {
            "type": "disk",
            "key": "    disk   ",
            "keyColor": "light_blue"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 4
        }
    ]
}