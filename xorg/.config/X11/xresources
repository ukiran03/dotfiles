! -*- compile-command: "xrdb ~/.config/X11/xresources" -*-

#include "active_theme"

! ==============================================================================
! Cursor Settings
! Reference: https://wiki.archlinux.org/title/Cursor_themes
! ==============================================================================
! Xcursor.theme:            Bibata-Modern-Classic
! Xcursor.size:             18

! ==============================================================================
! Xft Font Tweaking
! ==============================================================================
Xft.dpi:                    96
Xft.antialias:              true
Xft.rgba:                   rgb
Xft.hinting:                true
Xft.hintstyle:              hintslight
Xft.autohint:               true
Xft.lcdfilter:              lcddefault

! ==============================================================================
! URxvt Settings
! Reference: https://pod.tst.eu/http://cvs.schmorp.de/rxvt-unicode/doc/rxvt.1.pod
! Reference: https://smarttech101.com/urxvt-installation-color-scheme-fonts-resize-etc
! ==============================================================================

! Fonts (NOTE: For external monitor, size should be 11.25)
! URxvt.font:                 xft:Iosevka Term:size=14.25:style=Semibold
! URxvt.boldFont:             xft:Iosevka Term:size=14.25:style=Bold
! URxvt.italicFont:           xft:Iosevka Term:size=14.25:style=Italic
! URxvt.boldItalicFont:       xft:Iosevka Term:size=14.25:style=Bold Italic

! Monitor: 12.75, Laptop: 14.25, Laptop-Zoom: 16

URxvt.font:           xft:Iosevka Term:size=16:style=Semibold,xft:Iosevka Nerd Font Mono:size=16
URxvt.boldFont:       xft:Iosevka Term:size=16:style=Bold,xft:Iosevka Nerd Font Mono:size=16
URxvt.italicFont:     xft:Iosevka Term:size=16:style=Italic,xft:Iosevka Nerd Font Mono:size=16
URxvt.boldItalicFont: xft:Iosevka Term:size=16:style=Bold Italic,xft:Iosevka Nerd Font Mono:size=16

! Layout & Behavior
URxvt.letterSpace:          0
URxvt.lineSpace:            0
URxvt*geometry:             80x240+0+0
URxvt.internalBorder:       10
URxvt.cursorBlink:          true
URxvt.cursorUnderline:      false
URxvt*saveLines:            16384
URxvt.scrollBar:            false
URxvt.scrollBar_right:      false
URxvt.scrollBar_floating:   false
URxvt.scrollstyle:          rxvt
URxvt.iso14755:             false
URxvt.fading:               10
URxvt.depth:                32
URxvt.intensityStyles:      false
URxvt.urgentOnBell:         True

! Common Navigation Keybinds
URxvt.keysym.Shift-Up:      command:\033]720;1\007
URxvt.keysym.Shift-Down:    command:\033]721;1\007
URxvt.keysym.Control-Up:    \033[1;5A
URxvt.keysym.Control-Down:  \033[1;5B
URxvt.keysym.Control-Right: \033[1;5C
URxvt.keysym.Control-Left:  \033[1;5D

! Perl Extensions
URxvt.perl-ext-common:      clipboard,matcher,keyboard-select,resize-font
URxvt.perl-lib:             /home/ukiran/.config/urxvt/ext

! Extension: keyboard-select
URxvt.keysym.M-s:           builtin-string:
URxvt.keysym.C-Escape:      perl:keyboard-select:search
URxvt.keysym.M-Escape:      perl:keyboard-select:activate

! Extension: matcher
URxvt.url-launcher:         /usr/bin/xdg-open
URxvt.matcher.button:       1
URxvt.keysym.M-u:           perl:matcher:select

! Extension: clipboard
URxvt.clipboard.copycmd:    xclip -i -sel clip
URxvt.clipboard.pastecmd:   xclip -o -sel clip
URxvt.keysym.C-C:           perl:clipboard:copy
URxvt.keysym.C-V:           perl:clipboard:paste

! Extension: resize-font
URxvt.keysym.C-minus:       resize-font:smaller
URxvt.keysym.C-plus:        resize-font:bigger
URxvt.keysym.C-equal:       resize-font:reset
URxvt.keysym.C-question:    resize-font:show
URxvt.resize-font.step:     0.5

! ==============================================================================
! Xterm Settings
! ==============================================================================

! Basic Settings
xterm*termName:             xterm-256color
xterm*locale:               true
xterm*utf8:                 1
xterm*utf8Fonts:            always
xterm*dynamicColors:        true

! UI Components
xterm*toolBar:              false
xterm*scrollBar:            false
xterm*geometry:             80x24
xterm*internalBorder:       20
xterm*borderWidth:          0

! Cursor Appearance & Behavior
xterm*cursorColor:          reverse
xterm*cursorUnderLine:      false
xterm*pointerShape:         XTerm
xterm*cursorBlink:          true
xterm*cursorOffTime:        600
xterm*cursorOnTime:         1200

! Bell
xterm*bellIsUrgent:         false
xterm*bellSupressTime:      100
xterm*marginBell:           false
xterm*visualBell:           true

! Text Highlighting
xterm*highlightColor:       XtDefaultForeground
xterm*highlightReverse:     true
xterm*highlightSelection:   true
xterm*highlightTextColor:   XtDefaultBackground

! Font Settings
xterm*faceName:             xft:Iosevka Term:size=11.25:style=Semibold
xterm*renderFont:           true
xterm*boldColors:           false
xterm*scaleHeight:          1.0
xterm*forceBoxChars:        false
xterm*limitFontsets:        5
! xterm*faceSize:           8
xterm*faceSize1:            10
xterm*faceSize2:            12
xterm*faceSize3:            15
xterm*faceSize4:            18.25
xterm*faceSize5:            20.5
xterm*faceSize6:            25.5

! Scroll & Output Behavior
xterm*jumpScroll:           true
xterm*multiScroll:          true
xterm*saveLines:            9999
xterm*scrollKey:            true
xterm*scrollTtyKeypress:    true
xterm*scrollTtyOutput:      false

! Keyboard Behavior
xterm*backarrowKey:         false
xterm*metaSendsEscape:      true
xterm*ttyModes:             erase ^?

! Key Bindings (C-S-c / C-S-v for copy/paste, PgUp/PgDown for font size)
xterm*selectToClipboard:    true
xterm*translations:         #override \n\
    Ctrl Shift <KeyPress>C:     select-end(SELECT, CLIPBOARD) \n\
    Ctrl Shift <KeyPress>V:     insert-selection(SELECT, CLIPBOARD) \n\
    Ctrl Shift <KeyPress>Next:  smaller-vt-font() \n\
    Ctrl Shift <KeyPress>Prior: larger-vt-font() \n\
    Ctrl Shift <KeyPress>Home:  set-vt-font(d)
